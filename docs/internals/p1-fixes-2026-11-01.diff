+func validateVendorLocation(layout vendor.Layout, pf *config.ProjectFile) error {
+	if pf == nil || pf.Vendor == nil || pf.Vendor.Mode != "global" {
+		return nil
+	}
+	raw := strings.TrimSpace(pf.Vendor.GlobalPath)
