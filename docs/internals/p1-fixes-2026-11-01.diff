+// 项目内的 ngm.json 不能把 vendor 指到 ~/.ngm/global-vendor 之外。
+func TestP1ProjectGlobalPathStaysInNgmGlobalVendor(t *testing.T) {
+	layout := vendor.Layout{Home: t.TempDir()}
+
